# Copy to integrations-test/livekit-sarvam/.env and fill in. `.env` is gitignored.
#
#   cp integrations-test/livekit-sarvam/.env.example \
#      integrations-test/livekit-sarvam/.env

# ---------------------------------------------------------------- required
# Sarvam — STT (saarika), LLM, TTS (bulbul). One key covers all three.
# https://dashboard.sarvam.ai  ->  API Keys
SARVAM_API_KEY=

# ---------------------------------------------------------------- LiveKit
# NOT needed for `python integrations-test/livekit-sarvam/livekit_agent.py console` — console mode
# runs against your local microphone with no server at all. Start there.
#
# Needed only for `dev` mode, which serves a room you can join from a browser
# (https://agents-playground.livekit.io). Free tier is enough.
# https://cloud.livekit.io  ->  Settings -> Keys
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---------------------------------------------------------------- optional
# Which model and operating point the call runs at. Changing these is the
# point of a second call — run the same script twice and diff the reports.
#
#   tiny  8.7 MB, 83.71%  <- default, drop-in replacement for Smart Turn v3
#   base  21 MB,  86.13%
TAMIL_EOT_VARIANT=tiny

#   inherited  0.50  <- default. Every published number is quoted here.
#   polite     0.75 tiny / 0.92 base. Halves FP/N for ~3 accuracy points.
#   balanced   0.34 tiny / 0.24 base. Dev-best accuracy; did NOT transfer.
#
# `polite` is worth more under Pipecat, where a false `complete` interrupts
# the user outright. Under LiveKit it only shortens a pause.
TAMIL_EOT_OPERATING_POINT=inherited

# LiveKit endpointing, seconds. min_delay is the wait after a confident
# `complete`; below the threshold the session waits max_delay instead.
TAMIL_EOT_MIN_DELAY=0.3
TAMIL_EOT_MAX_DELAY=2.5

# Sarvam model overrides.
SARVAM_STT_MODEL=saarika:v2.5
SARVAM_TTS_MODEL=bulbul:v3

# LLM, and the two plugins do NOT accept the same values.
#   LiveKit: sarvam-m, sarvam-30b, sarvam-30b-16k, sarvam-105b, sarvam-105b-32k
#   Pipecat: sarvam-105b only
# Hence two variables rather than one that silently breaks one of the bots.
SARVAM_LLM_MODEL=sarvam-105b
SARVAM_LLM_MODEL_PIPECAT=sarvam-105b
